{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meusite",
  "main": "worker.js",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/diagnostics/*",
      "/wrangler.jsonc"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [{
    "binding": "DIAGNOSTICS_DB",
    "database_name": "renatajoin-controlled-mvp",
    "database_id": "REPLACE_AFTER_D1_CREATE",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "CONTROLLED_MVP_QUEUE", "queue": "renatajoin-controlled-mvp" }],
    "consumers": [{ "queue": "renatajoin-controlled-mvp", "max_batch_size": 1, "max_retries": 2 }]
  },
  "vars": { "OPENAI_MODEL": "gpt-5-mini" },
  // Sprint 6 — isolated staging environment. name/main/compatibility_date/assets/observability
  // are inherited from the top level; d1_databases/queues/vars are not inherited and are fully
  // restated here. Bindings DIAGNOSTICS_DB and CONTROLLED_MVP_QUEUE are kept identical to prod so
  // no application code branches on environment.
  "env": {
    "staging": {
      "name": "meusite-staging",
      "d1_databases": [{
        "binding": "DIAGNOSTICS_DB",
        "database_name": "renatajoin-controlled-mvp-staging",
        "database_id": "0c71a899-00ee-4ff3-874c-339a884ea49c",
        "migrations_dir": "migrations"
      }],
      "queues": {
        "producers": [{ "binding": "CONTROLLED_MVP_QUEUE", "queue": "renatajoin-controlled-mvp-staging" }],
        "consumers": [{ "queue": "renatajoin-controlled-mvp-staging", "max_batch_size": 1, "max_retries": 2 }]
      },
      "vars": { "OPENAI_MODEL": "gpt-5-mini", "STRATEGIC_CORE": "ON", "STRATEGIC_SIGNALS": "ON" }
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meusite",
  "main": "worker.js",
  "compatibility_date": "2026-07-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/diagnostics/*",
      "/api/commerce",
      "/api/commerce/*",
      "/wrangler.jsonc"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DIAGNOSTICS_DB",
      "database_name": "renatajoin-controlled-mvp",
      "database_id": "5a93eea5-d1b3-4c96-9193-5c976d989941",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CONTROLLED_MVP_QUEUE",
        "queue": "renatajoin-controlled-mvp"
      }
    ],
    "consumers": [
      {
        "queue": "renatajoin-controlled-mvp",
        "max_batch_size": 1,
        "max_retries": 2
      }
    ]
  },
  "vars": {
    "COMMERCE_MODE": "disabled",
    "OPENAI_MODEL": "gpt-5-mini",
    "STRATEGIC_CORE": "ON",
    "STRATEGIC_SIGNALS": "ON"
  },
  "env": {
    "staging": {
      "name": "meusite-loja-staging",
      "workers_dev": true,
      "routes": [
        {
          "pattern": "homologacao.renatajoin.com",
          "custom_domain": true,
          "zone_id": "96ae2319f45bfd25104b0944762e6c1e"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DIGITAL_PRODUCTS",
          "bucket_name": "meusite-digital-products-staging",
          "remote": false
        }
      ],
      "d1_databases": [
        {
          "binding": "COMMERCE_DB",
          "database_name": "meusite-commerce-staging",
          "database_id": "799f4cf2-8970-4716-990f-36445c166ab3",
          "migrations_dir": "migrations/commerce",
          "remote": false
        }
      ],
      "queues": {
        "producers": [],
        "consumers": []
      },
      "vars": {
        "COMMERCE_MODE": "disabled",
        "COMMERCE_ENVIRONMENT": "staging",
        "COMMERCE_ORIGIN": "https://homologacao.renatajoin.com"
      },
      "main": "worker/commerce/staging.js",
      "triggers": {
        "crons": ["* * * * *"]
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      },
      "preview_urls": false
    }
  }
}
